{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "dom"],
    "types": [],
    "typeRoots": [],
    "baseUrl": ".",
    "paths": { "@minecraft/*": ["./node_modules/@minecraft/*"] },
    "skipLibCheck": true
  },
  "include": ["../behavior_pack/scripts/**/*.js"]
}
